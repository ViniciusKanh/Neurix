{
  "name": "PredictionLog",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string",
      "description": "Reference to the Analysis used for prediction"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "classification",
        "regression"
      ]
    },
    "input_features": {
      "type": "object",
      "description": "Feature values used for the prediction"
    },
    "predicted_value": {
      "type": "string"
    },
    "actual_value": {
      "type": "string",
      "description": "User-provided correct value (feedback)"
    },
    "is_correct": {
      "type": "boolean"
    },
    "feedback_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "corrected"
      ],
      "default": "pending"
    },
    "confidence": {
      "type": "number"
    }
  },
  "required": [
    "analysis_id",
    "task_type"
  ]
}